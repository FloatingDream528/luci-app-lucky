#!/bin/sh /etc/rc.common

START=99
STOP=15
USE_PROCD=1

PROG=/usr/bin/lucky
DEFAULT_CONFDIR=/etc/config/lucky.daji

get_config() {
	config_get_bool enabled "$1" enabled 0
	config_get_bool log_enable "$1" logger 1
	config_get CONFDIR "$1" configdir "$DEFAULT_CONFDIR"
}

start_service() {
	if [ ! -x "$PROG" ]; then
		logger -t lucky -p daemon.err "Lucky core binary not found: $PROG"
		return 1
	fi

	local enabled=1
	local log_enable=1
	local CONFDIR="$DEFAULT_CONFDIR"

	if [ -s /etc/config/lucky ]; then
		config_load lucky
		config_foreach get_config lucky
	fi

	[ "$enabled" -eq 1 ] || return 0

	[ -n "$CONFDIR" ] || CONFDIR="$DEFAULT_CONFDIR"
	[ -d "$CONFDIR" ] || mkdir -p "$CONFDIR" 2>/dev/null

	procd_open_instance "lucky"
	procd_set_param command "$PROG" -cd "$CONFDIR"
	procd_set_param respawn
	procd_set_param stdout "$log_enable"
	procd_set_param stderr "$log_enable"
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "lucky"
}
